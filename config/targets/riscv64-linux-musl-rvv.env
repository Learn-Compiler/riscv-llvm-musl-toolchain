# ==============================================================================
# config/targets/riscv64-linux-musl-rvv.env - RISC-V 64 RVV (Vector 1.0) 目标平台配置
# ==============================================================================

# 目标三元组
TARGET_TRIPLE="riscv64-unknown-linux-musl"
T="$TARGET_TRIPLE"

# LLVM 后端构建架构
LLVM_TARGET_ARCH="RISCV"

# Musl 交叉编译 target
MUSL_TARGET="riscv64-linux-musl"

# 运行时 Builtins 静态库与目标产物文件名
RT_BUILTIN_NAME="libclang_rt.builtins-riscv64.a"
RT_CRT_BEGIN="clang_rt.crtbegin-riscv64.o"
RT_CRT_END="clang_rt.crtend-riscv64.o"
LD_MUSL_SO="ld-musl-riscv64.so.1"

# 默认开启 RISC-V 矢量扩展 (RVV 1.0, rv64gcv)
TARGET_EXTRA_CFLAGS="-march=rv64gcv -mabi=lp64d"

# 冒烟测试校验特征串
SMOKE_TEST_PATTERN="UCB RISC-V"

# 离线打包发布前缀名称
PACKAGE_NAME="riscv64-rvv-unknown-musl-linux"
