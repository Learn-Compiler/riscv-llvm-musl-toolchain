# ==============================================================================
# config/targets/riscv32-unknown-elf.env - RISC-V 32 Baremetal ELF (Picolibc)
# ==============================================================================

# 目标三元组
TARGET_TRIPLE="riscv32-unknown-elf"
T="$TARGET_TRIPLE"

# LLVM 后端构建架构 (单架构构建 RISCV，原生支持 32 位与 64 位)
LLVM_TARGET_ARCH="RISCV"

# 目标平台默认架构与 ABI 参数 (默认 rv32imac/ilp32，可命令行随时覆盖)
TARGET_EXTRA_CFLAGS="${TARGET_EXTRA_CFLAGS:--march=rv32imac -mabi=ilp32}"

# 运行时 Builtins 静态库与目标产物文件名
RT_BUILTIN_NAME="libclang_rt.builtins-riscv32.a"
RT_CRT_BEGIN="clang_rt.crtbegin-riscv32.o"
RT_CRT_END="clang_rt.crtend-riscv32.o"

# 冒烟测试校验特征串
SMOKE_TEST_PATTERN="ELF 32-bit"

# 离线打包发布前缀名称
PACKAGE_NAME="riscv32-unknown-elf"

# ==============================================================================
# 多 march 矩阵编译配置 (Multilib Matrix)
# ==============================================================================
ENABLE_MULTILIB="${ENABLE_MULTILIB:-ON}"

# 矩阵定义: 相对目录与对应的编译参数
MULTILIB_MATRIX=(
  "rv32i/ilp32:-march=rv32i -mabi=ilp32"
  "rv32im/ilp32:-march=rv32im -mabi=ilp32"
  "rv32iac/ilp32:-march=rv32iac -mabi=ilp32"
  ".:-march=rv32imac -mabi=ilp32"
  "rv32imafc/ilp32f:-march=rv32imafc -mabi=ilp32f"
  "rv32imafdc/ilp32d:-march=rv32imafdc -mabi=ilp32d"
  "rv64imac/lp64:-march=rv64imac -mabi=lp64"
  "rv64imafdc/lp64d:-march=rv64imafdc -mabi=lp64d"
)
