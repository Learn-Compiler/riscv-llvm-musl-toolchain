# ==============================================================================
# config/targets/riscv32-linux-musl.env - RISC-V 32 Musl 目标平台配置
# ==============================================================================

# 目标三元组
TARGET_TRIPLE="riscv32-unknown-linux-musl"
T="$TARGET_TRIPLE"

# LLVM 后端构建架构
LLVM_TARGET_ARCH="RISCV"

# Musl 交叉编译 target
MUSL_TARGET="riscv32-linux-musl"

# 运行时 Builtins 静态库与目标产物文件名
RT_BUILTIN_NAME="libclang_rt.builtins-riscv32.a"
RT_CRT_BEGIN="clang_rt.crtbegin-riscv32.o"
RT_CRT_END="clang_rt.crtend-riscv32.o"
LD_MUSL_SO="ld-musl-riscv32.so.1"

# 冒烟测试校验特征串
SMOKE_TEST_PATTERN="RISC-V"

# 离线打包发布前缀名称
PACKAGE_NAME="riscv32-unknown-musl-linux"
