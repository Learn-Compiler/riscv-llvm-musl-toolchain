# ==============================================================================
# config/local.env - 用户本地个性化配置（复制本文件为 config/local.env）
# 该文件已被 .gitignore 忽略，不会被提交到 Git 仓库
# ==============================================================================

# 1. 覆盖并行构建线程数
# JOBS=8

# 2. 挂载本地自研/二次开发源码目录（无需重新拉取上游 Git）
# LLVM_SRC="/path/to/your/custom-llvm-project"
# MUSL_SRC="/path/to/your/custom-musl"
# LINUX_HEADERS_SRC="/path/to/your/custom-linux-headers"
# TORCH_MLIR_SRC="/path/to/your/custom-torch-mlir"
# TORCH_MLIR_REF="v20261001" # 手动指定 torch-mlir 版本/标签/分支 (默认依据 LLVM 自动对齐)

# 3. 自定义组件编译参数（灵活构建 MLIR / torch-mlir / 额外参数）
# LLVM_ENABLE_PROJECTS="clang;lld;mlir"              # 编译 MLIR 组件，为 torch-mlir 提供支持
# LLVM_TARGETS_TO_BUILD="RISCV;X86"                  # 扩展目标架构列表 (如包含 Host JIT)
# LLVM_EXTRA_CMAKE_ARGS="-DLLVM_BUILD_EXAMPLES=OFF"  # 透传额外 LLVM CMake 参数
# MUSL_EXTRA_ARGS=""                                 # 透传额外 Musl configure 参数

# 4. 二次开发调试模式配置
# BUILD_TYPE="RelWithDebInfo"     # 推荐二次开发模式: -O2 -g，兼顾执行速度与符号调试
# RUNTIMES_BUILD_TYPE="Release"   # 目标端运行库构建模式 (默认 Release)
# RUNTIMES_OPT_LEVEL="-O2"        # 目标端运行库优化级别 (默认 -O2，可选 -O3, -Os, -O0)
# ENABLE_ASSERTIONS="ON"          # 开启断言，精确定位 Pass 与 ISel 语法/逻辑崩溃
# STRIP_SYMBOLS="OFF"             # 保留 gdb/lldb 调试符号

# 5. 目标运行库与链接模式配置
# ENABLE_SHARED="OFF"             # 目标运行时仅编译静态库 (默认 OFF)
# DEFAULT_STATIC_LINK="ON"        # 工具链 .cfg 默认追加 -static 静态链接 (默认 ON)
