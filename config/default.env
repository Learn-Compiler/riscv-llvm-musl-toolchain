# ==============================================================================
# config/default.env - 全局默认基础配置
# ==============================================================================

# 并行构建线程数 (默认 auto：自适应探测 CPU 物理核心与 RAM 内存容量，亦可由 -j/--jobs 或环境变量 JOBS 覆盖)
JOBS="${JOBS:-auto}"

# ccache 编译加速开关: AUTO (自动探测宿主是否有 ccache) | ON (开启，若宿主缺失则自动下载引导) | OFF (禁用)
ENABLE_CCACHE="${ENABLE_CCACHE:-AUTO}"

# 产物安装路径配置 (方案 C：解耦底层交叉编译工具链与统一 AI 编译器)
INSTALL_TOOLCHAIN="${INSTALL_TOOLCHAIN:-$SRC/install-toolchain}"
INSTALL_AI="${INSTALL_AI:-$SRC/install-ai}"
INSTALL="${INSTALL:-$INSTALL_TOOLCHAIN}"

# 源码仓库地址 (LLVM / Musl / Linux Headers / torch-mlir)
LLVM_REPO="https://github.com/llvm/llvm-project.git"
MUSL_REPO="https://github.com/kraj/musl.git"
LINUX_HEADERS_REPO="https://github.com/sabotage-linux/kernel-headers.git"
LINUX_HEADERS_REF="master"
LINUX_HEADERS_DIR="${LINUX_HEADERS_DIR:-$SRC/third_party/linux-headers}"

# ==============================================================================
# 组件编译参数灵活配置（支持子项目定制、MLIR、torch-mlir 扩展与额外参数）
# ==============================================================================
# LLVM 启用的子项目列表 (分号分隔)，需支持 MLIR/torch-mlir 时可配置为 "clang;lld;mlir"
LLVM_ENABLE_PROJECTS="${LLVM_ENABLE_PROJECTS:-clang;lld}"

# LLVM 目标架构列表 (分号分隔，留空则继承目标平台 LLVM_TARGET_ARCH 如 "RISCV")
# 编译 MLIR/torch-mlir 时可扩展包含宿主架构 (如 "RISCV;X86" 或 "all")
LLVM_TARGETS_TO_BUILD="${LLVM_TARGETS_TO_BUILD:-}"

# 额外的 LLVM CMake 编译参数 (透传至 LLVM cmake)
LLVM_EXTRA_CMAKE_ARGS="${LLVM_EXTRA_CMAKE_ARGS:-}"

# 额外的 Musl 编译配置参数 (透传至 musl configure)
MUSL_EXTRA_ARGS="${MUSL_EXTRA_ARGS:-}"

# torch-mlir 组件路径与配置 (以 LLVM 为主控基准版本匹配)
TORCH_MLIR_SRC="${TORCH_MLIR_SRC:-$SRC/third_party/torch-mlir}"
TORCH_MLIR_REPO="${TORCH_MLIR_REPO:-https://github.com/llvm/torch-mlir.git}"
TORCH_MLIR_EXTRA_CMAKE_ARGS="${TORCH_MLIR_EXTRA_CMAKE_ARGS:-}"
TORCH_MLIR_ENABLE_PYTHON="${TORCH_MLIR_ENABLE_PYTHON:-OFF}"

# triton 组件路径与配置 (以 LLVM 为主控基准版本匹配)
TRITON_SRC="${TRITON_SRC:-$SRC/third_party/triton}"
TRITON_REPO="${TRITON_REPO:-https://github.com/triton-lang/triton.git}"
TRITON_EXTRA_CMAKE_ARGS="${TRITON_EXTRA_CMAKE_ARGS:-}"
TRITON_ENABLE_PYTHON="${TRITON_ENABLE_PYTHON:-OFF}"


# 宿主自举引导工具回退下载地址 (当宿主缺失 cmake / ninja 时使用)
CMAKE_TARBALL="cmake-3.30.5-linux-x86_64"
CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v3.30.5/${CMAKE_TARBALL}.tar.gz"
NINJA_URL="https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip"
CCACHE_TARBALL="ccache-4.10.2-linux-x86_64"
CCACHE_URL="https://github.com/ccache/ccache/releases/download/v4.10.2/${CCACHE_TARBALL}.tar.xz"

# ==============================================================================
# 构建模式与调试配置（二次开发核心选项）
# ==============================================================================
# 编译类型: Release (默认发布版) | RelWithDebInfo (二次开发推荐) | Debug (纯调试版)
BUILD_TYPE="${BUILD_TYPE:-Release}"

# 目标端运行库编译类型: Release (默认) | RelWithDebInfo | Debug
RUNTIMES_BUILD_TYPE="${RUNTIMES_BUILD_TYPE:-Release}"

# 目标端运行库基础优化级别 (Musl / compiler-rt / libc++): 留空则采用各组件原生默认设置 (如 CMake Release 默认为 -O3, Musl 默认为 -O2)
# 若需显式指定可配置为 "-O2", "-O3", "-Os" 等
RUNTIMES_OPT_LEVEL="${RUNTIMES_OPT_LEVEL:-}"

# LLVM 断言开关: ON | OFF (二次开发强烈建议开启，能在第一时间捕获 Pass/ISel 语法与逻辑崩溃)
ENABLE_ASSERTIONS="${ENABLE_ASSERTIONS:-OFF}"

# 调试符号剥离开关: AUTO (Release 时为 ON，Debug/RelWithDebInfo 时为 OFF) | ON | OFF
STRIP_SYMBOLS="${STRIP_SYMBOLS:-AUTO}"

# ==============================================================================
# 目标端运行库与链接模式配置（静态库与共享库控制）
# ==============================================================================
# 目标端运行时共享库构建开关: OFF (默认纯静态库 .a，无 .so) | ON (同时构建共享库 .so)
ENABLE_SHARED="${ENABLE_SHARED:-OFF}"

# 工具链配置文件 (.cfg) 默认静态链接开关: ON (默认追加 -static) | OFF (默认动态链接)
DEFAULT_STATIC_LINK="${DEFAULT_STATIC_LINK:-ON}"
